.c3{background:linear-gradient(160deg,#d9824b 0%,#7a3b5c 55%,#0a2540)}.c4{background:linear-gradient(160deg,#4aa89a,#0d3a5c)}
.trust{background:#fff;border-radius:24px;padding:34px;display:grid;grid-template-columns:1fr 1.3fr;gap:30px;margin:60px 0}
.trust h2{font-size:2rem;letter-spacing:-.03em}
footer{background:var(--navy);color:#b9d3e3;padding:34px 0;font-size:.9rem}
@media(max-width:900px){.grid{grid-template-columns:1fr}.cond{position:static}.cards{grid-template-columns:1fr 1fr}.trust{grid-template-columns:1fr}
 .links{display:none;position:absolute;top:76px;left:4%;right:4%;background:var(--navy);padding:18px;border-radius:18px;flex-direction:column;gap:14px}
 .links.open{display:flex}.menu-btn{display:block}nav .btn-white{display:none}.hero{padding:130px 0 130px}}
@media(max-width:520px){.cards{grid-template-columns:1fr}.msg{max-width:100%}form{padding:14px}.chips,.chat-head,.log{padding-left:16px;padding-right:16px}.send{min-width:80px;padding:0 16px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
