<style>
:root{--navy:#0a2540;--deep:#0d3a5c;--teal:#0f6e7a;--aqua:#5ec8e5;--sand:#f6f1e7;--white:#fff;--ink:#14263a;--muted:#5b6b7b;--line:#dfe6ec;--ok:#1b7f4f;--warn:#b26a00;--bad:#b3261e}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:var(--ink);background:var(--sand);line-height:1.55;overflow-x:hidden}
a{color:inherit}
:focus-visible{outline:3px solid var(--aqua);outline-offset:2px}
.wrap{width:min(1120px,92%);margin:0 auto}
/* nav */
nav{position:absolute;inset:0 0 auto;z-index:5;padding:20px 0}
nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px}
.brand{display:flex;align-items:center;gap:10px;color:#fff;font-weight:800;font-size:1.3rem;letter-spacing:-.02em;text-decoration:none}
.links{display:flex;gap:30px}
.links a{color:#fff;text-decoration:none;font-weight:600}
.links a:hover{color:var(--aqua)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 26px;border-radius:999px;border:2px solid transparent;font:700 1rem inherit;font-family:inherit;cursor:pointer;text-decoration:none;transition:transform .15s,background .15s}
.btn:hover{filter:brightness(.94)}
.btn-white{background:#fff;color:var(--navy)}
.btn-ghost{border-color:rgba(255,255,255,.6);color:#fff}
.menu-btn{display:none;background:none;border:2px solid #fff;color:#fff;border-radius:10px;padding:8px 12px;font:700 .9rem inherit;font-family:inherit;cursor:pointer}
/* hero */
.hero{position:relative;color:#fff;padding:170px 0 150px;background:
 radial-gradient(ellipse at 80% 10%,rgba(94,200,229,.35),transparent 55%),
 linear-gradient(170deg,#0a2540 0%,#0d3a5c 55%,#0f6e7a 100%);overflow:hidden}
.hero svg.waves{position:absolute;left:0;bottom:-1px;width:100%;height:130px}
.loc{display:flex;align-items:center;gap:12px;font-weight:700;letter-spacing:.14em;font-size:.8rem;color:var(--aqua);margin-bottom:18px}
.loc::before{content:"";width:44px;height:4px;border-radius:4px;background:var(--aqua)}
h1{font-size:clamp(2.8rem,8.5vw,6.4rem);line-height:.95;letter-spacing:-.05em;font-weight:800;max-width:12ch}
.hero p{max-width:52ch;margin:26px 0 32px;font-size:1.15rem;color:#dbeaf3}
.hero .ctas{display:flex;gap:14px;flex-wrap:wrap}
/* chat section */
main{position:relative;z-index:2;margin-top:-70px}
.grid{display:grid;grid-template-columns:minmax(0,1.9fr) minmax(0,1fr);gap:24px;align-items:start}
.chat{background:#fff;border-radius:28px;box-shadow:0 12px 32px rgba(10,37,64,.12);overflow:hidden;display:flex;flex-direction:column}
.chat-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:20px 26px;border-bottom:1px solid var(--line);flex-wrap:wrap}
.chat-head h2{font-size:1.4rem;letter-spacing:-.02em;display:flex;align-items:center;gap:10px}
.dot{width:10px;height:10px;border-radius:50%;background:var(--aqua)}
.chat-head small{color:var(--muted);font-weight:600}
.log{height:min(470px,58vh);overflow-y:auto;padding:22px 26px;display:flex;flex-direction:column;gap:16px;background:#f9fbfc}
.msg{display:flex;gap:12px;max-width:92%;}
.msg.user{align-self:flex-end;flex-direction:row-reverse}
.av{flex:none;width:38px;height:38px;border-radius:50%;background:var(--navy);color:#fff;font-weight:800;font-size:.8rem;display:grid;place-items:center}
.msg.user .av{background:var(--teal)}
.bubble{background:#fff;border:1px solid var(--line);padding:12px 16px;border-radius:6px 20px 20px 20px;overflow-wrap:anywhere}
.msg.user .bubble{background:var(--navy);color:#fff;border-color:var(--navy);border-radius:20px 6px 20px 20px}
.bubble p+p,.bubble p+ul,.bubble ul+p{margin-top:8px}
.bubble ul{padding-left:20px}
.bubble.err{border-color:var(--bad);color:var(--bad);font-weight:600}
.meta{margin-top:8px;font-size:.78rem;color:var(--muted);font-weight:600}
.msg.user .meta{display:none}
.typing{display:flex;gap:10px;align-items:center;color:var(--muted);font-weight:600}
.chips{display:flex;gap:8px;flex-wrap:wrap;padding:14px 26px 0}
.chip{border:1.5px solid var(--line);background:#fff;border-radius:999px;padding:8px 14px;font:600 .85rem inherit;font-family:inherit;color:var(--deep);cursor:pointer}
.chip:hover{border-color:var(--teal);background:#eef8fa}
.try{padding:16px 26px 0;font-size:.8rem;font-weight:700;color:var(--muted)}
.chips{padding-top:8px}
form{display:flex;gap:10px;padding:16px 26px 22px}
input[type=text]{flex:1;min-width:0;min-height:50px;border-radius:999px;border:2px solid var(--line);padding:0 20px;font:500 1rem inherit;font-family:inherit}
input[type=text]:focus{border-color:var(--teal);outline:none}
.send{background:var(--navy);color:#fff;min-width:96px}
.send:disabled,.chip:disabled{opacity:.5;cursor:not-allowed;transform:none}
/* conditions */
.cond{background:var(--navy);color:#fff;border-radius:28px;padding:26px;position:sticky;top:20px}
.cond .tag{font-size:.75rem;letter-spacing:.14em;font-weight:700;color:var(--aqua)}
.wind{font-size:3.6rem;font-weight:800;letter-spacing:-.04em;line-height:1;margin:14px 0 4px}
.wind span{font-size:1.2rem;font-weight:600;color:#b9d3e3;margin-left:6px}
.cond dl{display:grid;grid-template-columns:1fr auto;gap:8px 12px;margin:18px 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.18);color:#dbeaf3}
.cond dd{font-weight:700;color:#fff}
.status{display:inline-block;border-radius:999px;padding:6px 14px;font-weight:700;font-size:.85rem;background:rgba(255,255,255,.12)}
.stamp{margin-top:14px;font-size:.8rem;color:#b9d3e3}
/* sections */
section.block{padding:90px 0 20px}
.block h2.title{font-size:clamp(2rem,4.5vw,3rem);letter-spacing:-.04em;line-height:1.05;margin-bottom:10px}
.block .lead{color:var(--muted);max-width:58ch;margin-bottom:30px}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{min-height:320px;border-radius:24px;padding:22px 64px 22px 22px;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}
.card::after{content:'';position:absolute;inset:40% 0 0;background:linear-gradient(transparent,rgba(10,37,64,.75))}
.go{position:absolute;right:18px;bottom:20px;z-index:2;width:38px;height:38px;border-radius:50%;border:1.5px solid rgba(255,255,255,.7);display:grid;place-items:center}
.art{position:absolute;inset:0;width:100%;height:100%}
.photo{position:absolute;inset:0;background-size:cover;background-position:center}
.hero-photo{position:absolute;inset:0;background:url(images/hero-paddleboard.jpg) center/cover no-repeat}
.hero.has-photo::before{content:"";position:absolute;inset:0;background:linear-gradient(100deg,rgba(10,37,64,.9) 0%,rgba(10,37,64,.55) 55%,rgba(10,37,64,.4) 100%)}
.hero.has-photo .scene{display:none}
.hero .wrap{position:relative;z-index:2}.hero svg.waves{z-index:2}
.about{display:grid;grid-template-columns:1.3fr 1fr;gap:16px;margin-top:60px}
.ph{border-radius:24px;min-height:300px;background-size:cover;background-position:center}
@media(max-width:900px){.about{grid-template-columns:1fr}.ph{min-height:220px}}
.card h3{font-size:1.4rem;position:relative;z-index:2;letter-spacing:-.02em}
.scene{position:absolute;right:0;bottom:40px;width:min(62%,760px);height:auto;opacity:.95}
.notice{margin:14px 26px 0;padding:12px 16px;border-radius:14px;background:#fff4e0;border:1px solid #e8c98a;color:#6b4300;font-size:.88rem;font-weight:600}
@media(max-width:900px){.scene{width:100%;opacity:.35;bottom:60px}}
